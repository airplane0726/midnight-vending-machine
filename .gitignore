# 秘密情報
.env
.env.*
!.env.example

# 作業ファイル
series/*/drafts/*
!series/*/drafts/.gitkeep
series/*/.lock
series/*/episodes/.staging-*
series/*/episodes/.backup-*
series/*/episodes/*/assets/
.tmp-*.part

__pycache__/
*.pyc

# 生成素材（大きいので Git 管理外。永続保存は series.json の asset_storage）。生成記録 records.json は Git 管理する
series/*/media/*/images/
series/*/media/*/videos/
series/*/media/*/audio/
series/*/media/*/covers/
series/*/media/**/.tmp-*

# 公開準備の生成物（brand から作り直せる）
brand/out/
site_draft/
series/*/publish/.ledger.lock
