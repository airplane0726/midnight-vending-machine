# 次の段階（外部サービス接続）で使う環境変数の名前だけを記載しています。
# 値は .env（Git 管理外）か、実行環境のシークレット設定に入れてください。リポジトリには絶対にコミットしないこと。

# 画像生成（OpenAI）。クラウド環境では不要：キーは環境のネットワーク用シークレットに保存し、通信経路で付与される。
# 手元のパソコンで実行する場合だけ、.env（Git 管理外）やシェルで設定する。
OPENAI_API_KEY=
# 生成素材の永続保存先（Google ドライブ）。値はクラウド環境の設定で入力する（Git・チャットに書かない）。
GOOGLE_DRIVE_REFRESH_TOKEN=
# 手元のパソコンで使う場合だけ（クラウド環境ではネットワーク用シークレットに保存する）
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# 動画生成（サービス未決定）
VIDEO_API_KEY=
# 音楽・効果音（サービス未決定。自作素材を使う場合は不要）
AUDIO_API_KEY=

# Instagram（プロアカウント・Instagram ログイン。GitHub の Actions シークレットにだけ登録する。クラウド環境・ファイル・会話には置かない）
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=

# YouTube Data API v3（OAuth 2.0）
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
