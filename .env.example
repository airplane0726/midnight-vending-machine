# 次の段階（外部サービス接続）で使う環境変数の名前だけを記載しています。
# 値は .env（Git 管理外）か、実行環境のシークレット設定に入れてください。リポジトリには絶対にコミットしないこと。

# 画像生成（サービス未決定）
IMAGE_API_KEY=
# 生成素材の永続保存先（サービス未決定。例: クラウドのオブジェクトストレージ）
ASSET_STORAGE_ACCESS_KEY=
ASSET_STORAGE_SECRET=

# 動画生成（サービス未決定）
VIDEO_API_KEY=
# 音楽・効果音（サービス未決定。自作素材を使う場合は不要）
AUDIO_API_KEY=

# Instagram Graph API（ビジネス/クリエイターアカウント + Facebookページ連携が必要）
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=

# YouTube Data API v3（OAuth 2.0）
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
